# Copy to config.env and fill in. Sourced on both OSC (submit) and your laptop (tunnel).

OSC_USER=yourname            # OSC username
OSC_ACCOUNT=PASxxxx          # project to charge jobs to
OSC_CLUSTER=cardinal         # cardinal | ascend (Ollama/vLLM modules only here; pitzer has none) (login host is $OSC_CLUSTER.osc.edu)

# Default job resources (override per-submit with extra sbatch args)
JOB_TIME=01:00:00
GPUS=1

# Ollama
OLLAMA_VERSION=0.32.0
OLLAMA_MODEL=llama3.2:3b     # pulled at startup only if OLLAMA_MODELS_DIR is set
OLLAMA_MODELS_DIR=           # empty = OSC's central read-only store (/fs/ess/pub_data/ollama/models); else e.g. /fs/project/PASxxxx/ollama/models
# Clusters without the ollama module (pitzer) run the module's Apptainer image
# instead. Copy it once from a cluster that has it, to storage all clusters see:
#   cp /apps/ollama/$OLLAMA_VERSION/ollama_$OLLAMA_VERSION.sif /fs/scratch/PASxxxx/$USER/ollama/
OLLAMA_SIF=                  # e.g. /fs/scratch/PASxxxx/yourname/ollama/ollama_0.32.0.sif

# vLLM
VLLM_VERSION=0.23.0
VLLM_MODEL=Qwen/Qwen3-8B     # Hugging Face id; must be in HF_HOME or downloadable
VLLM_ARGS=                   # extra `vllm serve` flags, e.g. "--tensor-parallel-size 2 --disable_custom_all_reduce"
VLLM_HF_HOME=                # empty = OSC's central read-only cache (/fs/ess/pub_data/vllm/.cache/huggingface)
