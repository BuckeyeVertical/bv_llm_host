# Settings for this checkout. Copy to config.env (gitignored) and fill in.
# Read on OSC by scripts/*.sh and on your laptop by scripts/tunnel.sh.
# Precedence: this file < the model profile (models/<name>.env) < your environment.

OSC_USER=yourname
OSC_ACCOUNT=PASxxxx          # project billed for GPU time
OSC_CLUSTER=ascend           # login host for tunnel.sh: ascend (A100) | cardinal (H100) | pitzer (V100)

# Storage. Use scratch or project space, never $HOME (small quota).
HF_CACHE=/fs/scratch/PASxxxx/$USER/hf          # vLLM weights not in OSC's shared cache
OLLAMA_CACHE=/fs/scratch/PASxxxx/$USER/ollama  # Ollama models not in OSC's shared store
STATE_DIR=                   # where running servers are listed; empty = ~/.bv_llm_host.
                             # Set a group-writable dir (e.g. /fs/ess/PASxxxx/llm_state) to share servers with your team.

# Job defaults
JOB_TIME=01:00:00
GPUS=1
PARTITION=                   # empty = cluster default. Ascend: quad = 80 GB A100s, nextgen = 40 GB, debug* = 1 h max

# Backend versions (OSC modules; list them with `module spider vllm` / `module spider ollama`)
VLLM_VERSION=0.23.0
OLLAMA_VERSION=0.40.6
# Only for clusters without those modules (Pitzer), see docs/notes.md
VLLM_VENV=                   # a venv with vllm installed
OLLAMA_SIF=                  # a copy of /apps/ollama/<version>/ollama_<version>.sif

# Public URL (vLLM only), see docs/public-access.md
EXPOSE=none                  # none | funnel
TS_HOSTNAME=bv-llm
TAILSCALE_DIR=/fs/scratch/PASxxxx/tools/tailscale
AUTO_RESUBMIT=0              # 1 = chain jobs past walltime
