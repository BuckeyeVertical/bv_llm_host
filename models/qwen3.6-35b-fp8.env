# Qwen3.6 35B-A3B FP8 (~35 GB). Vision, tool calling and thinking; one 80 GB GPU
# (Ascend: PARTITION=quad or debug-quad). Not in OSC's cache: downloads to HF_CACHE.
# --enable-prefix-caching matters: vLLM turns it off by default for this hybrid
# architecture, and without it every call reprocesses the whole prompt.
BACKEND=vllm
MODEL=Qwen/Qwen3.6-35B-A3B-FP8
ARGS="--max-model-len 32768 --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3 --enable-prefix-caching"
